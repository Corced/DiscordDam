# ─── Discord application ──────────────────────────────────────────────
# Bot token from the Discord Developer Portal (Bot tab → Reset Token).
DISCORD_BOT_TOKEN=

# OAuth2 application client ID from the Discord Developer Portal.
DISCORD_CLIENT_ID=

POSTGRES_DB=DiscordDam
POSTGRES_USER=DiscordDam
POSTGRES_PASSWORD=<secret>
GITHUB_REPO=<owner/repo>        # prod override only
IMAGE_TAG=latest                # prod override only

# OAuth2 application client secret from the Discord Developer Portal.
DISCORD_CLIENT_SECRET=

# OAuth2 redirect URI; must exactly match one registered in the Discord app
# settings and contain the path /auth/discord/callback.
# Local dev: http://localhost:3001/auth/discord/callback
DISCORD_REDIRECT_URI=

# Snowflake ID of the Discord server used as the membership gate.
# Discord → Settings → Advanced → Developer Mode, then right-click the
# server → Copy Server ID.
TARGET_GUILD_ID=

# ─── Tokens ───────────────────────────────────────────────────────────
# Secret used to sign JWTs. Min 32 chars, 64+ recommended for production.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour; max 86400).
JWT_EXPIRY=3600

# Refresh token lifetime in seconds (default 604800 = 7 days).
REFRESH_TOKEN_EXPIRY=604800

# Shared secret authenticating bot ↔ auth-server internal HTTP calls.
# Same value in both services. Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_INTERNAL_SECRET=

# ─── Infrastructure ───────────────────────────────────────────────────
# Postgres connection string: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Redis connection string: redis://host:6379
REDIS_URL=

# ─── URLs ─────────────────────────────────────────────────────────────
# Public URL of the API site; must be HTTPS in production.
SITE_URL=http://localhost:3001

# Invite link shown to non-members on the "join our Discord" page.
DISCORD_INVITE_LINK=https://discord.gg/yourserver

# How the bot reaches the auth server internally (Docker service name in compose).
AUTH_SERVER_INTERNAL_URL=http://localhost:3001

# How the auth server reaches the bot's internal API (Docker service name in compose).
BOT_INTERNAL_URL=http://localhost:3002

# ─── Ports ────────────────────────────────────────────────────────────
# Auth server HTTP port (default 3001).
PORT=3001

# Bot internal HTTP port (default 3002).
BOT_PORT=3002

# ─── Runtime ──────────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development

# Bot: Discord account that may always use moderator commands (snowflake user id)
DISCORD_OWNER_ID=
# Bot: optional role granting moderator command access (snowflake; leave empty to disable)
MOD_ROLE_ID=
# Bot: register slash commands globally instead of guild-scoped (default: false)
REGISTER_COMMANDS_GLOBALLY=false

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info