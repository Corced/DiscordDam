{
  "name": "@DiscordDam/auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrate.js",
    "clean": "tsc -b --clean",
    "test:integration": "vitest run",
    "test:unit": "vitest run --dir tests/unit"
  },
  "dependencies": {
    "@DiscordDam/shared": "workspace:*",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "msw": "^2.7.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}