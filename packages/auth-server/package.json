{
  "name": "@DiscordDam/auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrate.js",
    "clean": "tsc -b --clean",
    "test:integration": "vitest run",
    "test:unit": "vitest run --dir tests/unit"
  },
  "dependencies": {
    "@DiscordDam/shared": "workspace:*",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "p-limit": "^6.0.0",
    "pg": "^8.13.1",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "msw": "^2.7.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.16.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/p-limit": "^2.2.0"
  }
}