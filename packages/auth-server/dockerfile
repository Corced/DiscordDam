# syntax=docker/dockerfile:1

FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm

# Every workspace package manifest must exist BEFORE install —
# pnpm --frozen-lockfile cannot resolve workspace:* deps without them.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/auth-server/package.json ./packages/auth-server/
COPY packages/bot/package.json ./packages/bot/
# Delete the next line if packages/web isn't on disk in this checkout.
COPY packages/web/package.json ./packages/web/

RUN pnpm install --frozen-lockfile

COPY packages/ ./packages/

RUN pnpm --filter "./packages/auth-server..." build


FROM node:20-alpine AS runner
WORKDIR /app

# ponytail: whole-tree copy keeps pnpm symlinks valid; `pnpm deploy` if size matters.
COPY --from=builder /app ./

USER node

EXPOSE 3001

# Port literal must match PORT in .env (build-time, no env interpolation).
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3001/internal/health || exit 1

CMD ["node", "packages/auth-server/dist/index.js"]